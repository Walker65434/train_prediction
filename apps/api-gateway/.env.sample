PORT=3000
CORS_ORIGIN="http://<link_to_frontend>:<port>"
MONGODB_URI="mongodb+srv://<username>:<db_password>@<cluster_name>.xddhymd.mongodb.net/<db_name>"

DEBUG= # true or false
NODE_ENV= # "development" or "production"

# INFO: RabbitMQ Config
RABBITMQ_URL="amqp://<user>:<password>@<host>:<port>"
RABBITMQ_START_QUEUE= # producer start
RABBITMQ_STOP_QUEUE= # producer stop
RABBITMQ_RESULT_QUEUE= # consumer result
