  "license": "CC BY-NC 4.0",
  "version": "1.0.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:full": "turbo run dev",
    "infra": "docker compose up",
    "infra:down": "docker compose down",
    "format": "pnpm run format:js && pnpm run format:py",
    "format:js": "prettier --write \"**/*.{js,jsx,json,md,yml,yaml,css}\"",
    "format:py": "turbo run format",
    "format:check": "pnpm run format:check:js && pnpm run format:check:py",
    "format:check:js": "prettier --check .",
    "format:check:py": "turbo run format:check"
  },
  "devDependencies": {
    "prettier": "3.9.8",
    "turbo": "^2.11.2"
  },
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24"
  }
}
